@@ -0,0 +1,42 @@
+package org.com.quora_backend.config;
+
+import io.swagger.v3.oas.annotations.OpenAPIDefinition;
+import io.swagger.v3.oas.annotations.enums.SecuritySchemeType;
+import io.swagger.v3.oas.annotations.info.Contact;
+import io.swagger.v3.oas.annotations.info.Info;
+import io.swagger.v3.oas.annotations.security.SecurityScheme;
+import io.swagger.v3.oas.annotations.servers.Server;
+
+/**
+ * Central OpenAPI / Swagger configuration.
+ *
+ * Once the application is running, docs are available at:
+ *   - Swagger UI : http://localhost:8080/swagger-ui.html
+ *   - OpenAPI JSON: http://localhost:8080/v3/api-docs
+ *   - OpenAPI YAML: http://localhost:8080/v3/api-docs.yaml
+ *
+ * Click "Authorize" in the Swagger UI and paste a raw JWT (no "Bearer " prefix,
+ * springdoc adds it automatically) to call endpoints that require authentication.
+ */
+@OpenAPIDefinition(
+        info = @Info(
+                title = "QueryNest API",
+                version = "v1",
+                description = "REST API for QueryNest - a Quora-style Q&A backend built with Spring Boot. " +
+                        "Supports user management, questions, answers and voting, secured with JWT authentication.",
+                contact = @Contact(name = "Abhilash Panja", url = "https://github.com/Abhilash-Panja/querynest-backend")
+        ),
+        servers = {
+                @Server(url = "/", description = "Default server")
+        },
+        security = @io.swagger.v3.oas.annotations.security.SecurityRequirement(name = "bearerAuth")
+)
+@SecurityScheme(
+        name = "bearerAuth",
+        type = SecuritySchemeType.HTTP,
+        scheme = "bearer",
+        bearerFormat = "JWT",
+        description = "Provide the JWT returned by POST /api/v1/auth/login"
+)
+public class OpenApiConfig {
+}
